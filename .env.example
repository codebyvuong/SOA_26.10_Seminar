APP_PORT=8000
PROMETHEUS_PORT=9091
GRAFANA_PORT=3005
WEBHOOK_PORT=5001
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Load Generator
LOADGEN_MODE=NORMAL
LOADGEN_DELAY=0.5

ALERTMANAGER_PORT=9093

# Telegram Bot Token & Chat ID (CHỈ DÙNG PLACEHOLDER TRONG FILE NÀY)
# 1. Tạo Bot từ @BotFather trên Telegram để nhận Token.
# 2. Lấy Chat ID từ @userinfobot hoặc qua API Telegram.
# 3. Điền vào file .env trên máy của bạn (file .env đã được đưa vào .gitignore).
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
